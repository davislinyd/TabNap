{
  "manifest_version": 3,
  "name": "TabNap",
  "version": "1.2.2",
  "description": "休眠閒置分頁以釋放記憶體；穩定版使用 Discard，Dev 版可終止 process",
  "permissions": ["activeTab", "alarms", "contextMenus", "processes", "scripting", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon16.png"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TabNap"
  },
  "commands": {
    "_execute_action": {
      "description": "Activate the extension"
    },
    "end-current-tab": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      },
      "description": "釋放當前分頁"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
